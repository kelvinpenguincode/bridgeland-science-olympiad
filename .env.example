# ─────────────────────────────────────────────────────────────────────────
# Bridgeland Science Olympiad — environment variables
#
# Copy this file to `.env.local` and fill in real values from your Supabase
# project (Project Settings → API). Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────

# Public — safe to expose to the browser. Used by both the browser and
# server Supabase clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only. NEVER prefix this with NEXT_PUBLIC_ and never expose
# it to the browser. Used by src/lib/supabase/admin.ts for privileged
# server-side operations (bypasses Row Level Security). Optional for local
# development — most admin features work fine with just the two vars above.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
